table v_mro_model_metrics
	description: "Synthetic AeroCIE research. Decision outputs need underwriter review."

	column manufacturer
		dataType: string
		sourceColumn: manufacturer
		summarizeBy: none

	column model
		dataType: string
		sourceColumn: model
		summarizeBy: none

	column facility_count
		dataType: int64
		sourceColumn: facility_count
		summarizeBy: none

	column latest_observation
		dataType: string
		sourceColumn: latest_observation
		summarizeBy: none

	column mro_severity_days
		dataType: double
		sourceColumn: mro_severity_days
		summarizeBy: none

	column mro_cost_pressure_index
		dataType: double
		sourceColumn: mro_cost_pressure_index
		summarizeBy: none

	column mean_parts_availability
		dataType: double
		sourceColumn: mean_parts_availability
		summarizeBy: none

	column oldest_observation
		dataType: string
		sourceColumn: oldest_observation
		summarizeBy: none

	column provenance_source_count
		dataType: int64
		sourceColumn: provenance_source_count
		summarizeBy: none

	partition v_mro_model_metrics = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(AeroCIEDataFolder & "v_mro_model_metrics.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {{"manufacturer", type text},{"model", type text},{"facility_count", Int64.Type},{"latest_observation", type text},{"oldest_observation", type text},{"mro_severity_days", type number},{"mro_cost_pressure_index", type number},{"mean_parts_availability", type number},{"provenance_source_count", Int64.Type}})
			in
			    Typed
