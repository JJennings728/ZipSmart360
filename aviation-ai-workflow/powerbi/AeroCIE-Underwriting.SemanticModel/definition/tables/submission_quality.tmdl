table submission_quality
	description: "Synthetic source integrity and input completeness. Does not certify provider authority."

	column submission_id
		dataType: string
		sourceColumn: submission_id
		summarizeBy: none

	column research_label
		dataType: string
		sourceColumn: research_label
		summarizeBy: none

	column risk_points
		dataType: int64
		sourceColumn: risk_points
		summarizeBy: none

	column quality_status
		dataType: string
		sourceColumn: quality_status
		summarizeBy: none

	column issue_codes
		dataType: string
		sourceColumn: issue_codes
		summarizeBy: none

	partition submission_quality = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(AeroCIEDataFolder & "submission_quality.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted, {{"submission_id", type text}, {"research_label", type text}, {"risk_points", Int64.Type}, {"quality_status", type text}, {"issue_codes", type text}})
			in
			    Typed
